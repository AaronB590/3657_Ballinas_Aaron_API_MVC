{
  "name": "cumbre-cafe-api-mvc",
  "version": "1.0.0",
  "private": true,
  "description": "API académica MVC para las nueve tablas de Cumbre Café.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/validation.test.js tests/error-handler.test.js",
    "test:api": "node scripts/test-api.js",
    "postman:generate": "node scripts/generate-postman.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "mysql2": "3.24.6"
  }
}
